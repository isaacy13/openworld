[Desktop Entry]
Type=Application
Name=OpenWorld
Comment=Check a photo or video you already have against public FBI missing and wanted posters, on this device
Exec=openworld-desktop %f
Icon=app.openworld.OpenWorld
Terminal=false
StartupNotify=true
Categories=Graphics;Viewer;
Keywords=photo;video;poster;missing;wanted;
MimeType=image/jpeg;image/png;image/webp;image/gif;image/tiff;image/heic;image/heif;image/avif;video/mp4;video/quicktime;video/x-matroska;video/webm;video/x-msvideo;video/3gpp;video/ogg;
