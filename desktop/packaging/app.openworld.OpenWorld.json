{
  "id": "app.openworld.OpenWorld",
  "runtime": "org.gnome.Platform",
  "runtime-version": "46",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "openworld-desktop",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/openworld-desktop/cargo",
      "CARGO_NET_OFFLINE": "true"
    }
  },
  "cleanup": ["/include", "/lib/pkgconfig", "/share/doc", "/share/man", "*.a"],
  "modules": [
    {
      "name": "ffmpeg",
      "config-opts": [
        "--disable-debug",
        "--disable-doc",
        "--disable-static",
        "--enable-shared",
        "--disable-network",
        "--disable-ffplay",
        "--disable-autodetect"
      ],
      "cleanup": ["/share/ffmpeg"],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/FFmpeg/FFmpeg.git",
          "tag": "n7.1.1",
          "commit": "db69d06eeeab4f46da15030a80d539efb4503ca8"
        }
      ]
    },
    {
      "name": "onnxruntime",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 onnxruntime/capi/libonnxruntime.so.* /app/lib/libonnxruntime.so"
      ],
      "sources": [
        {
          "type": "archive",
          "archive-type": "zip",
          "strip-components": 0,
          "url": "https://files.pythonhosted.org/packages/95/df/5486ab03e9be288d5268867054c8b04bebcf95bfd12e801c05cc67703dab/onnxruntime-1.28.0-cp312-cp312-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl",
          "sha256": "0a83bdb70d143cede762b677789bf2a7acca54b3fb82565601d5c30695aa933c",
          "only-arches": ["x86_64"]
        },
        {
          "type": "archive",
          "archive-type": "zip",
          "strip-components": 0,
          "url": "https://files.pythonhosted.org/packages/28/5b/1d77e62097fdbe07e2dc827f389b1c4c0c275f6fab0369a8f46d2461af27/onnxruntime-1.28.0-cp312-cp312-manylinux_2_27_aarch64.manylinux_2_28_aarch64.whl",
          "sha256": "4e81a23df16e7acb9d51b06d30cc098e49315ef9180f97bc2221d167b4b04d9c",
          "only-arches": ["aarch64"]
        }
      ]
    },
    {
      "name": "openworld-desktop",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline build --release --manifest-path desktop/Cargo.toml",
        "install -Dm755 desktop/target/release/openworld-desktop /app/bin/openworld-desktop",
        "mkdir -p /app/bin/bundles && for b in bundles/*/; do install -Dm644 \"$b\"manifest.toml /app/bin/\"$b\"manifest.toml; if [ -f \"$b\"curve.json ]; then install -Dm644 \"$b\"curve.json /app/bin/\"$b\"curve.json; fi; done",
        "install -Dm644 desktop/packaging/app.openworld.OpenWorld.desktop /app/share/applications/app.openworld.OpenWorld.desktop",
        "install -Dm644 desktop/packaging/app.openworld.OpenWorld.metainfo.xml /app/share/metainfo/app.openworld.OpenWorld.metainfo.xml",
        "install -Dm644 desktop/packaging/app.openworld.OpenWorld.svg /app/share/icons/hicolor/scalable/apps/app.openworld.OpenWorld.svg"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": ["desktop/target", "core/target", "third_party", ".git"]
        },
        "cargo-sources.json"
      ]
    }
  ]
}
