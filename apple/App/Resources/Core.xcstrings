        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al continuar, aceptas los Términos de uso, incluido el arbitraje individual vinculante y la renuncia a demandas colectivas, y la Política de privacidad y la Política de datos biométricos."
          }
        }
      }
    },
