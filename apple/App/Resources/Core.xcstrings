    "leave_missing": {
      "comment": "A core sentence, looked up by its code (docs/api.md). Keep the meaning exact.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This opens an FBI missing-person poster. It is not a criminal accusation. Do not approach, follow, or try to hold anyone, especially a child. Missing-child posters typically list NCMEC at 1-800-THE-LOST (1-800-843-5678)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto abre un cartel de persona desaparecida del FBI. No es una acusación penal. No te acerques, no sigas ni intentes retener a nadie, en especial a un menor. Los carteles de menores desaparecidos suelen indicar NCMEC en el 1-800-THE-LOST (1-800-843-5678)."
          }
        }
      }
    },
